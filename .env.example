# Safe to expose in a browser; protect data with Supabase Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RADAR_FUNCTION_NAME=radar-connectors
NEXT_PUBLIC_SITE_URL=https://sleepinghbd.github.io/Sift
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# Strategy evidence retrieval and validated ChatGPT-response imports use the
# authenticated Supabase function. The default manual handoff needs no AI key.
NEXT_PUBLIC_STRATEGY_AI_FUNCTION_NAME=strategy-ai
